# ==============================================================================
# Signal CI/CD Vulnerability Scanner - Environment Configuration Template
# ==============================================================================
# IMPORTANT: Copy this file to .env for local development.
# NEVER commit real credentials, private keys, or payment secrets to git.
# ==============================================================================

# Global Environment
NODE_ENV=development

# ------------------------------------------------------------------------------
# API Service Configuration (apps/api)
# ------------------------------------------------------------------------------
PORT=4000
API_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# Database Connection (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/signal?schema=public

# Redis Connection (BullMQ Job Queue & Rate Limiting)
REDIS_URL=redis://localhost:6379

# Cryptographic & Session Secrets (Min 32 characters in production)
SESSION_SECRET=dev-session-secret-change-in-production-min-32-chars
COOKIE_SECRET=dev-cookie-secret-change-in-production-min-32-chars

# GitHub App Integration
# Created at: https://github.com/settings/apps
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=""
GITHUB_APP_WEBHOOK_SECRET=

# Google OAuth (Phase 4 - Authentication)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# Billing Provider Configuration (Phase 8 - Stripe / Razorpay)
BILLING_PROVIDER=stripe

# Stripe Subscriptions (Recommended for international SaaS)
STRIPE_SECRET_KEY=sk_test_placeholder_key
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret
STRIPE_PRICE_ID_MONTH=
STRIPE_PRICE_ID_QUARTER=
STRIPE_PRICE_ID_YEAR=

# Razorpay Subscriptions (Alternate adapter, subject to merchant eligibility)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_never_commit_real
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Resend Transactional Email Communications
RESEND_API_KEY=re_placeholder_key
EMAIL_FROM="Signal Security <billing@threadsecurity.in>"

# ------------------------------------------------------------------------------
# Background Worker Configuration (apps/worker)
# ------------------------------------------------------------------------------
WORKER_CONCURRENCY=5
SCAN_MAX_FILES_PER_REPO=100
SCAN_MAX_WORKFLOW_BYTES=500000

# ------------------------------------------------------------------------------
# Web Frontend Configuration (apps/web)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:4000
