# ==============================================================================
# Dockerfile — Signal API Service (for Render Docker deployments)
# ==============================================================================
# Use this if you prefer Docker over Render's native Node runtime.
# Set "dockerfilePath: ./Dockerfile.api" in render.yaml to use it.
# ==============================================================================

FROM node:22-alpine AS base
WORKDIR /app

# ---------- Dependencies ----------
FROM base AS deps
COPY package.json package-lock.json ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/database/package.json ./packages/database/
COPY packages/scanner-rules/package.json ./packages/scanner-rules/
COPY apps/api/package.json ./apps/api/
RUN npm ci --omit=dev

# ---------- Build ----------
FROM base AS build
COPY package.json package-lock.json ./
COPY packages/ ./packages/
COPY apps/api/ ./apps/api/
COPY tsconfig.json tsconfig.base.json ./
RUN npm ci
RUN npm run build:packages
RUN npm run build --workspace=@signal/api

# ---------- Production ----------
FROM base AS production
ENV NODE_ENV=production

# Copy production dependencies
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages/shared/node_modules ./packages/shared/node_modules 2>/dev/null || true
COPY --from=deps /app/packages/database/node_modules ./packages/database/node_modules 2>/dev/null || true
COPY --from=deps /app/packages/scanner-rules/node_modules ./packages/scanner-rules/node_modules 2>/dev/null || true
COPY --from=deps /app/apps/api/node_modules ./apps/api/node_modules 2>/dev/null || true

# Copy built artifacts
COPY --from=build /app/packages/shared/dist ./packages/shared/dist
COPY --from=build /app/packages/shared/package.json ./packages/shared/
COPY --from=build /app/packages/database/dist ./packages/database/dist
COPY --from=build /app/packages/database/package.json ./packages/database/
COPY --from=build /app/packages/scanner-rules/dist ./packages/scanner-rules/dist
COPY --from=build /app/packages/scanner-rules/package.json ./packages/scanner-rules/
COPY --from=build /app/apps/api/dist ./apps/api/dist
COPY --from=build /app/apps/api/package.json ./apps/api/

# Copy Prisma schema for runtime client generation
COPY packages/database/prisma ./packages/database/prisma
COPY package.json ./

# Generate Prisma client for production
RUN npx prisma generate --schema=packages/database/prisma/schema.prisma

EXPOSE 10000
CMD ["node", "apps/api/dist/index.js"]

