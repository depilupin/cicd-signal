{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      ".prisma/client/default": ["../../node_modules/.prisma/client/default.d.ts"],
      ".prisma/client/*": ["../../node_modules/.prisma/client/*"],
      ".prisma/client": ["../../node_modules/.prisma/client/index.d.ts"]
    }
  },
  "include": ["src"]
}
