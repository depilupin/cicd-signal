{
  "name": "@signal/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc -b",
    "typecheck": "tsc -b --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@signal/scanner-rules": "*",
    "@signal/shared": "*"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "prisma": "^6.4.1",
    "typescript": "~6.0.2"
  }
}
