{
  "name": "signal-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"api,web\" -c \"blue,green\" \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm run dev --workspace=@signal/web",
    "dev:api": "npm run dev --workspace=@signal/api",
    "dev:worker": "npm run dev --workspace=@signal/worker",
    "build": "npm run build --workspaces --if-present",
    "build:packages": "npm run build --workspace=@signal/shared --workspace=@signal/scanner-rules --workspace=@signal/database",
    "build:api": "npm run build:packages && npm run build --workspace=@signal/api",
    "build:worker": "npm run build:packages && npm run build --workspace=@signal/worker",
    "build:web": "npm run build --workspace=@signal/web",
    "start:api": "node apps/api/dist/index.js",
    "start:worker": "node apps/worker/dist/index.js",
    "deploy:hostinger": "cd apps/web && npm run build",
    "db:migrate:deploy": "npx prisma migrate deploy --schema=packages/database/prisma/schema.prisma",
    "db:push": "npx prisma db push --schema=packages/database/prisma/schema.prisma",
    "postinstall": "npx prisma generate --schema=packages/database/prisma/schema.prisma",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
